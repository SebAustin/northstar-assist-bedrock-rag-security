# AgentCore Harness Configuration
AGENTCORE_HARNESS_ARN=arn:aws:bedrock-agentcore:us-east-1:your-account-id:harness/your-harness-id
AWS_REGION=us-east-1

# App Authentication (leave empty for no password)
APP_PASSWORD=

# AWS Credentials (optional - can also use ~/.aws/credentials or IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Monitoring page (pages/1_Monitoring.py), CloudWatch source
# Bedrock model-invocation log group written by infra/05_monitoring.sh
INVOCATION_LOG_GROUP=/northstar/bedrock/invocations
# Substring of the harness execution role ARN used to filter invocation records
HARNESS_ROLE_NAME=AmazonBedrockAgentCoreHarnessDefaultServiceRole
# Optional: directory holding suite_*.jsonl for the local source (default: <repo>/results)
# RESULTS_DIR=
