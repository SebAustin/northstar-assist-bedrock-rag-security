{
    "PolicyVersion": {
        "Document": {
            "Version": "2012-10-17",
            "Statement": [
                {
                    "Sid": "GetGateway",
                    "Effect": "Allow",
                    "Action": [
                        "bedrock-agentcore:GetGateway"
                    ],
                    "Resource": [
                        "arn:aws:bedrock-agentcore:us-east-1:609617804976:gateway/northstar-assist-gateway-*"
                    ]
                },
                {
                    "Sid": "GetConfigurationBundleVersion",
                    "Effect": "Allow",
                    "Action": [
                        "bedrock-agentcore:GetConfigurationBundleVersion"
                    ],
                    "Resource": [
                        "arn:aws:bedrock-agentcore:us-east-1:609617804976:configuration-bundle/*"
                    ],
                    "Condition": {
                        "StringEquals": {
                            "aws:ResourceAccount": "${aws:PrincipalAccount}",
                            "aws:RequestedRegion": "us-east-1"
                        }
                    }
                }
            ]
        },
        "VersionId": "v1",
        "IsDefaultVersion": true,
        "CreateDate": "2026-10-10T19:09:08+00:00"
    }
}
